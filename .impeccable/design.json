      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Outlined shell action, including the stop-all control.",
      "html": "<button class=\"ds-secondary\">Desactivar todas</button>",
      "css": ".ds-secondary{font-family:var(--hoard-font-sans);font-size:14px;font-weight:600;background:transparent;color:var(--hoard-text);border:1px solid var(--hoard-border);padding:10px 16px;border-radius:6px;cursor:pointer}.ds-secondary:hover{background:var(--hoard-elevated);border-color:var(--hoard-border-hover)}.ds-secondary:disabled{opacity:.55;cursor:default}.ds-secondary:focus-visible{outline:3px solid var(--hoard-accent);outline-offset:4px}"
