      "refersTo": "nav-current",
      "description": "Current Functions section in desktop navigation.",
      "html": "<a class=\"ds-nav\" href=\"#\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 7h16M4 17h16M9 4v6m6 4v6\"/></svg>Funciones</a>",
      "css": ".ds-nav{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:6px;color:var(--hoard-text-muted);text-decoration:none;font-family:var(--hoard-font-sans);font-size:14px}.ds-nav:hover{background:var(--hoard-elevated);color:var(--hoard-text)}.ds-nav[aria-current=page]{background:var(--hoard-elevated);color:var(--hoard-accent);font-weight:600}.ds-nav svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.ds-nav:focus-visible{outline:3px solid var(--hoard-accent);outline-offset:4px}"
    },
    {
      "name": "Module switch OFF",
      "kind": "button",
      "refersTo": "switch-off",
      "description": "Completed module state with adjacent label and switch track.",
      "html": "<button type=\"button\" class=\"ds-switch\" role=\"switch\" aria-label=\"Productos y ofertas\" aria-checked=\"false\"><span>Desactivada</span><span class=\"ds-track\" aria-hidden=\"true\"><span class=\"ds-thumb\"></span></span></button>",
      "css": ".ds-switch{display:flex;gap:10px;align-items:center;border:0;padding:8px 0 8px 8px;min-height:44px;background:transparent;color:var(--hoard-text-muted);font-family:var(--hoard-font-sans);font-size:13px;cursor:pointer}.ds-track{width:42px;height:24px;border-radius:14px;background:var(--hoard-border);padding:3px;flex:none}.ds-thumb{display:block;width:18px;height:18px;border-radius:50%;background:var(--hoard-text);transition:transform .16s ease-out}.ds-switch[aria-checked=true]{color:var(--hoard-accent)}.ds-switch[aria-checked=true] .ds-track{background:var(--hoard-accent)}.ds-switch[aria-checked=true] .ds-thumb{background:var(--hoard-accent-ink);transform:translateX(18px)}.ds-switch:disabled{opacity:.55;cursor:default}.ds-switch:focus-visible{outline:3px solid var(--hoard-accent);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-thumb{transition:none}}"
    },
    {
      "name": "Module switch ON",
      "kind": "button",
      "refersTo": "switch-on",
      "description": "Completed module state with adjacent label and switch track.",
      "html": "<button type=\"button\" class=\"ds-switch\" role=\"switch\" aria-label=\"Productos y ofertas\" aria-checked=\"true\"><span>Activada</span><span class=\"ds-track\" aria-hidden=\"true\"><span class=\"ds-thumb\"></span></span></button>",
      "css": ".ds-switch{display:flex;gap:10px;align-items:center;border:0;padding:8px 0 8px 8px;min-height:44px;background:transparent;color:var(--hoard-text-muted);font-family:var(--hoard-font-sans);font-size:13px;cursor:pointer}.ds-track{width:42px;height:24px;border-radius:14px;background:var(--hoard-border);padding:3px;flex:none}.ds-thumb{display:block;width:18px;height:18px;border-radius:50%;background:var(--hoard-text);transition:transform .16s ease-out}.ds-switch[aria-checked=true]{color:var(--hoard-accent)}.ds-switch[aria-checked=true] .ds-track{background:var(--hoard-accent)}.ds-switch[aria-checked=true] .ds-thumb{background:var(--hoard-accent-ink);transform:translateX(18px)}.ds-switch:disabled{opacity:.55;cursor:default}.ds-switch:focus-visible{outline:3px solid var(--hoard-accent);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-thumb{transition:none}}"
    },
    {
      "name": "Module row",
      "kind": "custom",
      "description": "Flat module structure and disabled Open link; no raised card.",
      "html": "<article class=\"ds-row\"><div><h2>Productos y ofertas<span class=\"ds-origin\">Tantalus</span></h2><p>Stock, precios, preventas, segunda mano, radar, noticias y ofertas por correo.</p></div><a class=\"ds-open\" aria-disabled=\"true\" tabindex=\"-1\">Abrir</a></article>",
      "css": ".ds-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:22px;padding:22px 0;border-top:1px solid var(--hoard-border);font-family:var(--hoard-font-sans);color:var(--hoard-text)}.ds-row h2{font-size:19px;font-weight:600;margin:0 0 6px}.ds-origin{font-weight:400;color:var(--hoard-text-dim);font-size:13px;margin-left:10px}.ds-row p{font-size:14px;line-height:1.6;color:var(--hoard-text-muted);margin:0;max-width:72ch}.ds-open{align-self:center;font-size:14px;font-weight:600;color:var(--hoard-accent)}.ds-open:hover{color:var(--hoard-accent-strong)}.ds-open[aria-disabled=true]{pointer-events:none;color:var(--hoard-text-dim);text-decoration:none}.ds-open:focus-visible{outline:3px solid var(--hoard-accent);outline-offset:4px}@media(max-width:650px){.ds-row{gap:10px}.ds-origin{display:block;margin:4px 0 0}.ds-row p{font-size:13px}}"
    },
